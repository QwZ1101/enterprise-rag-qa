# =====================================================================
# 复制本文件为 .env，并填入你自己的密钥（.env 已被 .gitignore 忽略，不会提交）
# 也可以直接把这些变量设到系统环境变量里，效果相同。
# =====================================================================

# 【必需】阿里云 DashScope：对话模型 qwen3.8-flash + 向量模型 qwen3.7-text-embedding-flash
# 申请：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 【建库 / PDF 解析时必需，纯问答不需要】MinerU 在线 PDF 解析
# 申请：https://mineru.net
MINERU_API_KEY=

# ---- 以下为上游遗留可选功能（本项目默认走 DashScope，不需要可留空）----
OPENAI_API_KEY=
GEMINI_API_KEY=
JINA_API_KEY=
